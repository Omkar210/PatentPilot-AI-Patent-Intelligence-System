# =============================================================
# PatentPilot AI — Environment Variables
# Copy this file to .env and fill in all values before running.
# NEVER commit the actual .env file — it is in .gitignore.
# =============================================================

# -----------------------------
# PostgreSQL (matches docker-compose.yml defaults)
# -----------------------------
DATABASE_URL=postgresql+psycopg2://patentpilot:patentpilot@localhost:5432/patentpilot

# -----------------------------
# LLM Providers — primary: Gemini, fallback: Groq
# -----------------------------
GOOGLE_API_KEY=your-google-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here

# -----------------------------
# Neo4j Graph Database (matches docker-compose.yml defaults)
# -----------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=patentpilot123

# -----------------------------
# PatentsView API (https://patentsview.org/apis/api-endpoints)
# -----------------------------
PATENTSVIEW_API_KEY=your-patentsview-api-key-here

# -----------------------------
# Semantic Scholar API (https://api.semanticscholar.org/)
# -----------------------------
SEMANTIC_SCHOLAR_API_KEY=your-semantic-scholar-api-key-here

# -----------------------------
# ChromaDB (embedded persistent client — no server needed)
# -----------------------------
CHROMA_PERSIST_PATH=./chroma_data

