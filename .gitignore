postgres_data/
neo4j_data/
neo4j_logs/
neo4j_plugins/
neo4j_import/

# -------  Uploads & Generated  -------
uploads/
reports/
*.pdf

# -------  Node / Frontend (Phase 6)  -------
frontend/node_modules/
