*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.Python
pip-log.txt
pip-delete-this-directory.txt

# -------  Virtual Environment  -------
venv/
.venv/
env/
ENV/

# -------  Environment & Secrets  -------
.env
*.env
!.env.example

# -------  IDE & Editor  -------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# -------  Testing  -------
.pytest_cache/
.coverage
htmlcov/
*.log

# -------  Database & Storage  -------
*.db
*.sqlite3
chroma_data/
alembic/versions/__pycache__/

